{
  "edit_predictions": {
    "provider": "zed"
  },
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "agent_servers": {
    "pi-acp": {
      "default_config_options": {
        "model": "anthropic/claude-opus-5-0"
      },
      "default_model": "anthropic/claude-sonnet-4-6",
      "type": "custom",
      "command": "pi-acp",
      "env": {
        "PI_ACP_SHOW_SESSION_ID": "true"
      }
    }
  },
  "agent": {
    "dock": "left",
    "tool_permissions": {
      "default": "allow",
      "tools": {
        "terminal": {
          "default": "allow"
        },
        "edit_file": {
          "default": "allow"
        }
      }
    },
    "expand_edit_card": false,
    "expand_terminal_card": false,
    "use_modifier_to_send": false,
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "copilot_chat",
      "model": "claude-sonnet-4.6"
    }
  },
  "icon_theme": "Material Icon Theme",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": "Catppuccin Latte",
  "terminal": {
    "font_family": "Cascadia Code PL",
    "font_size": 13,
    "font_features": {
      "calt": true
    },
    "line_height": {
      "custom": 1.6
    },
    "cursor_shape": "bar",
    "env": {
      "COLORTERM": "truecolor"
    }
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/.claude",
    "**/.codex",
    "**/.cursor",
    "**/.venv",
    "**/node_modules",
    "**/.pnpm-store",
    "**/.turbo",
    "**/.svelte-kit",
    "**/.next",
    "**/dist",
    "**/build"
  ],
  "auto_install_extensions": {
    "html": true,
    "svelte": true,
    "catppuccin": true,
    "material-icon-theme": true,
    "biome": true
  },
  "lsp": {
    "protobuf-language-server": {
      "binary": {
        "path": "buf",
        "arguments": ["beta", "lsp"]
      }
    }
  },
  "languages": {
    "YAML": {
      "format_on_save": "off"
    },
    "Python": {
      "language_servers": ["py", "ruff"],
      "format_on_save": "on",
      "formatter": [
        {
          "code_action": "source.fixAll.ruff"
        },
        {
          "language_server": {
            "name": "ruff"
          }
        }
      ]
    }
  }
}
